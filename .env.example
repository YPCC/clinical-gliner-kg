# Optional: enable spaCy-LLM adjudication instead of the heuristic adjudicator.
OPENAI_API_KEY=
# Optional: Fastino Pioneer API if you use the hosted GLiNER2 client.
PIONEER_API_KEY=
# Default extraction backend: auto | gliner25 | gliner_spacy | heuristic
CLINICAL_GLINER_BACKEND=auto
# Default GLiNER 2.5 checkpoint (small is friendliest for CPU demos)
GLINER25_MODEL=fastino/gliner2.5-small-v1
# Classic GLiNER checkpoint used by gliner-spacy
GLINER_SPACY_MODEL=urchade/gliner_medium-v2.1
# Optional PII checkpoint
GLINER_PII_MODEL=fastino/gliner2-privacy-filter-PII-multi
