# Copy to .env. Do not commit real keys.
# Modes themselves live in config/pipeline.yaml (local vs API).

# --- GLiNER ---
# local | huggingface_api | pioneer
GLINER_MODE=local
CLINICAL_GLINER_BACKEND=auto
GLINER25_MODEL=fastino/gliner2.5-small-v1
GLINER_SPACY_MODEL=urchade/gliner_medium-v2.1
GLINER_PII_MODEL=fastino/gliner2-privacy-filter-PII-multi
# huggingface_api
HF_TOKEN=
# pioneer (Fastino hosted): https://docs.pioneer.ai/authentication
PIONEER_API_KEY=

# --- oaklib ---
# local | ols | bioportal
OAK_MODE=local
OAK_EAGER=0
# OAK_ADAPTERS=simpleobo:/data/ontologies/mondo.obo,sqlite:/data/ontologies/chebi.db
BIOPORTAL_API_KEY=

# --- LLM exception path ---
# none | openai | openai_compat | azure_openai | google | vertex | anthropic
LLM_PROVIDER=none
LLM_ENABLE=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible base (Groq, vLLM, Ollama, Together, LiteLLM, Gemini OpenAI compat)
LLM_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
ANTHROPIC_API_KEY=
# Gemini API key (not Vertex). https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_MODEL=gemini-2.0-flash

# --- GCP Application Default Credentials (llm.provider=vertex) ---
# Leave GOOGLE_APPLICATION_CREDENTIALS unset to use:
#   gcloud auth application-default login
#   or the GCE/GKE/Cloud Run metadata server
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_QUOTA_PROJECT=

# --- PHI ---
PHI_ACTION=tag
